# Server Port
PORT=5001

# SMTP Configuration (Gmail SMTP)
# Host for Gmail is smtp.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender Gmail Address (The Gmail account used to send emails)
SMTP_USER=regulationbharat@gmail.com

# Google 16-character App Password (Generated from Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_PASS=your-16-digit-app-password

# Recipient Email (Where the contact enquiries will be delivered)
TO_EMAIL=regulationbharat@gmail.com
